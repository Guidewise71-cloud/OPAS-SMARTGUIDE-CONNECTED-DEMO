# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OIDC settings for the development-only GET /api/me identity endpoint.
# Leave blank until you have the real identity provider issuer and API audience.
OPAS_OIDC_ISSUER=""
OPAS_OIDC_AUDIENCE=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local SmartGuide bridge. Must match OPAS_INTEGRATION_SECRET in OPAS-SmartGuide/.env.local
SMARTGUIDE_API_BASE_URL=http://127.0.0.1:3001
OPAS_INTEGRATION_SECRET=opas-smartguide-local-demo-shared-secret-change-before-production-2026
