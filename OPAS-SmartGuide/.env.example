# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional DeepSeek fallback. Applicant context is sent to DeepSeek when it handles a request.
DEEPSEEK_API_KEY=""

# Optional Gemini failover through Vertex AI. Enable the Vertex AI API and
# authenticate the server with Application Default Credentials.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required to sign staff API sessions. Use a long random secret in production.
OPAS_AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# SQLite OPAS intelligence store (relative paths are resolved from the project directory)
OPAS_SQLITE_PATH="data/opas.sqlite"

# Meta WhatsApp Business Cloud API (provider is disabled until both are supplied)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Twilio SMS gateway
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend email gateway
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""

# External assistant API (used server-side by src/server/assistantClient.ts).
# Put the real key only in your local .env file, never in this example file.
ASSISTANT_API_URL="https://<free-url-from-the-Domains-page>/api/assistant"
ASSISTANT_API_KEY="GUIDEWISE"

# n8n applicant details validation (src/server/applicantDetailsCorrection.ts).
# Header name and value must match the Header Auth credential on the n8n webhook.
# Put the real secret only in your local .env file, never in this example file.
SMARTGUIDE_VALIDATION_WEBHOOK_URL="https://al-alw.app.n8n.cloud/webhook/opas-smartguide-validate"
SMARTGUIDE_VALIDATION_HEADER_NAME=""
SMARTGUIDE_VALIDATION_SECRET=""
