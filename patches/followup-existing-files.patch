+  // Server-confirmed resubmission of a reverted application. Status changes only after the server answers.
+  const resubmitRevertedApplication = async (): Promise<ResubmitResult> => {
+    if (!currentApp) return { success: false, error: 'No application is open.' };
+    if (currentApp.status !== 'REVERTED_ACTION_REQUIRED') return { success: false, error: 'This application is not waiting for corrections.' };
+    const targetId = currentApp.id;
+    try {
+      const response = await fetch('/api/opas/resubmit', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify({ applicationReference: currentApp.referenceNumber, userId: currentApp.userId }),
+      });
+      const data = await response.json().catch(() => ({}));
+      if (!response.ok || data.success !== true || !data.confirmationNumber) {
+        return { success: false, error: typeof data.error === 'string' ? data.error : `The OPAS server answered ${response.status}.` };
+      }
+      const resubmittedAt = String(data.resubmittedAt || new Date().toISOString());
+      setApplications(prev => prev.map(app => app.id !== targetId ? app : {
+        ...app,
+        status: 'UNDER_REVIEW',
+        updatedAt: resubmittedAt,
+        resubmission: { confirmationNumber: data.confirmationNumber, resubmittedAt, smartGuideSynced: Boolean(data.smartGuide?.synced) },
+        statusHistory: [...app.statusHistory, {
+          status: 'UNDER_REVIEW',
+          timestamp: resubmittedAt,
+          note: `Applicant resubmitted corrections. Confirmation ${data.confirmationNumber}.`,
+          updatedBy: 'Applicant',
+        }],
+      }));
+      return { success: true, confirmationNumber: data.confirmationNumber, resubmittedAt, smartGuideSynced: Boolean(data.smartGuide?.synced) };
+    } catch (error) {
+      return { success: false, error: error instanceof Error ? `Could not reach the OPAS server (${error.message}).` : 'Could not reach the OPAS server.' };
+    }
+  };
