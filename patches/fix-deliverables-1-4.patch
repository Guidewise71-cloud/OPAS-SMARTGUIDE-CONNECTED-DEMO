@@ -0,0 +1,98 @@
+// SMS (Twilio) and WhatsApp (Meta WhatsApp Cloud API) senders for automated reminders.
+// Both read the same env keys that /api/notifications/providers/status reports on.
+import type { SendResult } from './resendEmail.ts';
+
+type Env = Record<string, string | undefined>;
+
+export interface TextMessage {
+  /** Recipient phone number in international format, e.g. +260971234567. */
+  to: string;
+  body: string;
+}
+
+export function isSmsConfigured(env: Env = process.env): boolean {
+  return Boolean(env.TWILIO_ACCOUNT_SID?.trim() && env.TWILIO_AUTH_TOKEN?.trim() && env.TWILIO_FROM_NUMBER?.trim());
+}
+
+export function isWhatsAppConfigured(env: Env = process.env): boolean {
+  return Boolean(env.WHATSAPP_ACCESS_TOKEN?.trim() && env.WHATSAPP_PHONE_NUMBER_ID?.trim());
+}
+
+/** Optional safety net for demos: redirects every SMS/WhatsApp to one test number. */
+function resolveRecipient(to: string, env: Env) {
+  const testPhone = env.NOTIFICATION_TEST_PHONE?.trim();
+  return testPhone ? { to: testPhone, prefix: `[TEST for ${to}] ` } : { to, prefix: '' };
+}
+
+function normalisePhone(value: string) {
+  const digits = value.replace(/[^\d+]/g, '');
+  return digits.startsWith('+') ? digits : `+${digits}`;
+}
+
+export async function sendSmsViaTwilio(
+  message: TextMessage,
+  env: Env = process.env,
+  fetchImpl: typeof fetch = fetch,
+): Promise<SendResult> {
+  if (!isSmsConfigured(env)) return { ok: false, reason: 'SMS provider (Twilio) is not configured.' };
+  const sid = env.TWILIO_ACCOUNT_SID!.trim();
+  const { to, prefix } = resolveRecipient(normalisePhone(message.to), env);
+  const form = new URLSearchParams({ To: to, From: env.TWILIO_FROM_NUMBER!.trim(), Body: `${prefix}${message.body}` });
+  try {
+    const response = await fetchImpl(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(sid)}/Messages.json`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${sid}:${env.TWILIO_AUTH_TOKEN!.trim()}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: form.toString(),
+      signal: AbortSignal.timeout(10_000),
+    });
+    const payload: any = await response.json().catch(() => null);
+    if (!response.ok || !payload?.sid) return { ok: false, reason: payload?.message || `Twilio HTTP ${response.status}` };
+    return { ok: true, providerMessageId: String(payload.sid) };
+  } catch (error) {
+    return { ok: false, reason: error instanceof Error ? error.message : 'Twilio request failed.' };
+  }
+}
+
+/**
+ * Sends a WhatsApp message. Meta only allows free text inside the 24-hour
+ * customer-service window; reminders outside it need an approved template,
+ * set with WHATSAPP_TEMPLATE_NAME (body parameter 1 = the full reminder text).
+ */
+export async function sendWhatsAppMessage(
+  message: TextMessage,
+  env: Env = process.env,
+  fetchImpl: typeof fetch = fetch,
+): Promise<SendResult> {
+  if (!isWhatsAppConfigured(env)) return { ok: false, reason: 'WhatsApp provider is not configured.' };
+  const { to, prefix } = resolveRecipient(normalisePhone(message.to), env);
+  const text = `${prefix}${message.body}`;
+  const template = env.WHATSAPP_TEMPLATE_NAME?.trim();
+  const payload = template
+    ? {
+        messaging_product: 'whatsapp', to: to.replace(/^\+/, ''), type: 'template',
+        template: {
+          name: template,
+          language: { code: env.WHATSAPP_TEMPLATE_LANGUAGE?.trim() || 'en' },
+          components: [{ type: 'body', parameters: [{ type: 'text', text }] }],
+        },
+      }
+    : { messaging_product: 'whatsapp', to: to.replace(/^\+/, ''), type: 'text', text: { body: text } };
+  try {
+    const version = env.WHATSAPP_API_VERSION?.trim() || 'v21.0';
+    const response = await fetchImpl(`https://graph.facebook.com/${version}/${encodeURIComponent(env.WHATSAPP_PHONE_NUMBER_ID!.trim())}/messages`, {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${env.WHATSAPP_ACCESS_TOKEN!.trim()}`, 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload),
+      signal: AbortSignal.timeout(10_000),
+    });
+    const body: any = await response.json().catch(() => null);
+    const id = body?.messages?.[0]?.id;
+    if (!response.ok || !id) return { ok: false, reason: body?.error?.message || `WhatsApp HTTP ${response.status}` };
+    return { ok: true, providerMessageId: String(id) };
+  } catch (error) {
+    return { ok: false, reason: error instanceof Error ? error.message : 'WhatsApp request failed.' };
+  }
+}
