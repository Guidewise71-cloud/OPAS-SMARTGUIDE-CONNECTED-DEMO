+  }
+  if (application.status === 'Paid - Unsubmitted') {
+    return {
+      subject: 'MoHAIS OPAS: payment received, submission still needed',
+      content: `MoHAIS OPAS: Dear ${name}, we received your payment for application #${ref}, but the application has not been submitted. Please log in to OPAS, book your biometrics appointment and complete the final submission. You do not need to pay again.`,
