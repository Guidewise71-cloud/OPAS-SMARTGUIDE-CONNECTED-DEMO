+type DispatchOutcome = { channel: ReminderChannel; status: NotificationLog['deliveryStatus']; detail: string; failureReason?: string };
+
+/** Tries each usable channel in rule priority order and stops at the first one a provider accepts. */
+async function dispatchReminder(application: PassportApplication, channels: ReminderChannel[], subject: string, content: string, dedupeKey: string): Promise<DispatchOutcome> {
+  const failures: string[] = [];
+  for (const channel of channels) {
+    if (channel === 'WhatsApp') {
+      if (!isWhatsAppConfigured()) { failures.push('WhatsApp: not configured'); continue; }
+      const result = await sendWhatsAppMessage({ to: application.contact.whatsappNumber || application.contact.phone, body: content });
+      if (result.ok) return { channel, status: 'Sent', detail: `WhatsApp accepted (${result.providerMessageId}).` };
+      failures.push(`WhatsApp: ${(result as { reason: string }).reason}`);
+    } else if (channel === 'SMS') {
+      if (!isSmsConfigured()) { failures.push('SMS: not configured'); continue; }
+      const result = await sendSmsViaTwilio({ to: application.contact.phone, body: content });
+      if (result.ok) return { channel, status: 'Sent', detail: `Twilio accepted (${result.providerMessageId}).` };
+      failures.push(`SMS: ${(result as { reason: string }).reason}`);
+    } else if (channel === 'Email') {
+      if (!isResendConfigured()) { failures.push('Email: not configured'); continue; }
+      const result = await sendEmailViaResend({ to: application.contact.email, subject, text: content });
+      if (result.ok) return { channel, status: 'Sent', detail: `Resend accepted (${result.providerMessageId}).` };
+      failures.push(`Email: ${(result as { reason: string }).reason}`);
+    } else {
+      const applicant = findApplicantAccount(application);
+      if (!applicant) { failures.push('OPAS Message Board: no linked applicant account'); continue; }
+      saveApplicantMessage({
+        id: `msg-${dedupeKey}`, applicantUserId: applicant.id, applicationReference: application.trackingNumber,
+        channel: 'OPAS_MESSAGE_BOARD', subject, content, status: 'AVAILABLE', createdAt: new Date().toISOString(),
+        batchId: 'AUTOMATED_REMINDER', dedupeKey,
+      });
+      return { channel, status: 'Delivered', detail: 'Posted to the applicant OPAS Message Board.' };
+    }
+  }
+  return { channel: channels[0] || 'OPAS Message Board', status: 'Failed', detail: 'No channel accepted the reminder.', failureReason: failures.join('; ') };
+}
