+    return {
+      subject: 'MoHAIS OPAS: correction needed on your passport application',
+      content: `MoHAIS OPAS: Dear ${name}, your application #${ref} was returned for correction.${reason} Please log in to OPAS, fix the listed items and resubmit. You do not need to pay again; your earlier payment remains linked to this application.`,
