+    const fetchMock = vi.fn();
+    const result = await sendSmsViaTwilio({ to: '+260971234567', body: 'hi' }, {}, fetchMock as unknown as typeof fetch);
+    expect(result.ok).toBe(false);
+    expect(fetchMock).not.toHaveBeenCalled();
