+
+  it('accepts an already international mobile number', () => {
+    expect(validatePhoneNumber('+260 97 123 4567')).toMatchObject({ isValid: true, formatted: '+260971234567' });
+  });
+
+  it('rejects a number that is too short', () => {
+    expect(validatePhoneNumber('+260 95 12').isValid).toBe(false);
+  });
+
+  it('rejects letters and an empty number', () => {
+    expect(validatePhoneNumber('09712abc67').isValid).toBe(false);
