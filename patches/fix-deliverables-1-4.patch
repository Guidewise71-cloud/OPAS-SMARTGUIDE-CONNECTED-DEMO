+// Single source of truth for approved FAQ answers (EOI 3.1).
+// Used by the local grounding engine, the AI prompt, and the portal FAQ list.
+import { APPROVED_FAQS, type FAQItem } from '../data/faqs.ts';
+
+const STOP_WORDS = new Set([
+  'a', 'an', 'the', 'is', 'are', 'do', 'does', 'i', 'my', 'me', 'to', 'for', 'of', 'and', 'or', 'in', 'on',
+  'what', 'why', 'how', 'where', 'when', 'can', 'has', 'have', 'was', 'be', 'it', 'this', 'that', 'not', 'much',
+]);
+
+function tokens(text: string): string[] {
+  return text
+    .toLowerCase()
+    .replace(/[^a-z0-9\s-]/g, ' ')
+    .split(/\s+/)
+    .filter((t) => t.length > 1 && !STOP_WORDS.has(t));
+}
+
+function stem(word: string) {
+  return word.replace(/(ing|ed|es|s)$/, '');
+}
+
+/** Scores a message against one FAQ. Tags weigh more than question words. */
+export function scoreFaq(message: string, faq: FAQItem): number {
+  const lower = message.toLowerCase();
+  const messageStems = new Set(tokens(message).map(stem));
+  let score = 0;
+  for (const tag of faq.tags) {
+    const tagLower = tag.toLowerCase();
+    if (tagLower.includes(' ') || tagLower.includes('-')) {
+      if (lower.includes(tagLower) || lower.includes(tagLower.replace('-', ' '))) score += 3;
+    } else if (messageStems.has(stem(tagLower))) {
+      score += 2;
+    }
+  }
+  for (const word of new Set(tokens(faq.question).map(stem))) {
+    if (messageStems.has(word)) score += 1;
+  }
+  return score;
+}
+
+/** Minimum score for an approved answer to be returned verbatim. */
+export const FAQ_MATCH_THRESHOLD = 5;
+
+export function matchApprovedFaq(message: string, faqs: FAQItem[] = APPROVED_FAQS): FAQItem | null {
+  if (!message || !message.trim()) return null;
+  let best: FAQItem | null = null;
+  let bestScore = 0;
+  for (const faq of faqs) {
+    const score = scoreFaq(message, faq);
+    if (score > bestScore) {
+      best = faq;
+      bestScore = score;
+    }
+  }
+  return bestScore >= FAQ_MATCH_THRESHOLD ? best : null;
+}
+
+/** Block appended to the AI system prompt so model answers never contradict approved FAQs. */
+export function approvedFaqPromptBlock(faqs: FAQItem[] = APPROVED_FAQS): string {
+  const body = faqs.map((faq) => `Q: ${faq.question}\nA: ${faq.answer}`).join('\n\n');
+  return `APPROVED FAQ ANSWERS (authoritative). When the user's question matches one of these, answer from it and do not contradict it. If other guidance in this prompt conflicts with an approved answer, the approved answer wins.\n\n${body}`;
+}
+
+export function formatApprovedFaqReply(faq: FAQItem): string {
+  return `**${faq.question}**\n\n${faq.answer}\n\n_Source: approved MoHAIS FAQ (${faq.category})._`;
+}
