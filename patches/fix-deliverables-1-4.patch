+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * EOI 3.4 anti-spam rule: an applicant receives at most one reminder in any
+ * 72-hour window, across every rule, channel and reminder source.
+ */
+export const MIN_REMINDER_INTERVAL_HOURS = 72;
+
+const REMINDER_TRIGGERS: NonNullable<NotificationLog['trigger']>[] = [
+  'AUTOMATED_WORKFLOW',
+  'BULK_REMINDER',
+  'SMARTGUIDE_PAYMENT_DETECTION',
+];
+
+function notificationTime(notification: NotificationLog): number {
+  return new Date(notification.timestamp || notification.deliveryUpdatedAt || '').getTime();
+}
+
+function isWithinWindow(notification: NotificationLog, windowMs: number, now: Date): boolean {
+  const timestamp = notificationTime(notification);
+  return Number.isFinite(timestamp) && now.getTime() - timestamp < windowMs;
+}
+
+/**
+ * Days the case has spent in its current status. Uses the stored status-change
+ * time when available, so cases synced from OPAS age even though nothing
+ * increments daysInStatus.
+ */
+export function effectiveDaysInStatus(application: PassportApplication, now: Date = new Date()): number {
+  const stored = application.daysInStatus || 0;
+  const changedAt = application.statusChangedAt ? new Date(application.statusChangedAt).getTime() : NaN;
+  if (!Number.isFinite(changedAt)) return stored;
+  return Math.max(0, Math.floor((now.getTime() - changedAt) / DAY_MS));
+}
+
+/** Returns the most recent reminder of any kind, or null. */
+export function lastReminderAt(application: PassportApplication): Date | null {
+  const times = application.notifications
+    .filter((n) => n.trigger && REMINDER_TRIGGERS.includes(n.trigger) && n.deliveryStatus !== 'Cancelled')
+    .map(notificationTime)
+    .filter(Number.isFinite);
+  return times.length ? new Date(Math.max(...times)) : null;
 }
 
